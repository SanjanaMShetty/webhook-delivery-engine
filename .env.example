DATABASE_URL=postgresql+psycopg://webhook:devpassword@localhost:5432/webhooks
REDIS_URL=redis://localhost:6379/0
WEBHOOK_ENCRYPTION_KEY=

# Endpoint protections. Set ALLOW_PRIVATE_WEBHOOK_TARGETS=true only for local receiver testing.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false
ENDPOINT_RATE_LIMIT_PER_SECOND=10
ENDPOINT_CONCURRENCY_LIMIT=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
